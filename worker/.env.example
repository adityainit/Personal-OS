# For running the worker on your own computer. On Render, set these under Environment instead
# (the render.yaml Blueprint asks for them). Copy to .env and fill in. Never commit .env.

# Same values as the web app (Supabase → Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Your Personal OS login. The worker signs in as you, so database security still applies.
PERSONAL_OS_EMAIL=you@example.com
PERSONAL_OS_PASSWORD=your-password

# Where the WhatsApp login is kept:
#   supabase (default): encrypted in your database, survives restarts on hosts without a disk
#   file: the local worker/auth folder
WA_AUTH_STORE=supabase
# Encrypts the WhatsApp login (supabase store). Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value everywhere you run the worker. Changing it means scanning a new QR.
WA_AUTH_SECRET=

# Optional: your WhatsApp number with country code (digits only), to also get an
# 8-character code for "Link with phone number instead".
WA_PAIRING_PHONE=

# Optional
# WA_AUTH_DIR=./auth      folder for WA_AUTH_STORE=file
# POLL_SECONDS=60         how often to check the queue
# LOG_LEVEL=info          debug | info | warn | error
# PORT=3001               start the health-check server locally
